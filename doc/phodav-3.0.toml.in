[library]
version = "@PHODAV_VERSION@"
browse_url = "https://gitlab.gnome.org/GNOME/phodav/"
repository_url = "https://gitlab.gnome.org/GNOME/phodav.git"
website_url = "https://gitlab.gnome.org/GNOME/phodav"
authors = "Marc-André Lureau <marcandre.lureau@redhat.com>"
license = "LGPL-2.1-or-later"
description = "A WebDAV server library based on libsoup"
devhelp = true
search_index = true

dependencies = ["Gio-2.0", "Soup-3.0"]

  [dependencies."Gio-2.0"]
  name = "Gio"
  description = "GObject interfaces and objects, networking, IPC and I/O"
  docs_url = "https://docs.gtk.org/gio/"

  [dependencies."Soup-3.0"]
  name = "Soup"
  description = "An HTTP client/server library"
  docs_url = "https://libsoup.gnome.org/libsoup-3.0/"

[theme]
name = "basic"
show_index_summary = true
show_class_hierarchy = true

[source-location]
base_url = "https://gitlab.gnome.org/GNOME/phodav/-/blob/master/"
