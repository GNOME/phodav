#: bin/chezdav.c:142
msgid "--tls-cert contains no private key, pass it with --tls-key\n"
msgstr "--tls-cert ne vsebuje zasebnega ključa; posredujete ga s --tls-key\n"

#: bin/chezdav.c:179
msgid "Print program version"
msgstr "Izpiši različico programa"

#: bin/chezdav.c:180
msgid "Be verbose"
msgstr "Izpis naj bo podroben"

#: bin/chezdav.c:181
msgid "Unix socket to listen on"
msgstr "Vtičnica Unixa za poslušanje"

#: bin/chezdav.c:182
msgid "Port to listen to"
msgstr "Vrata za prisluh"

#: bin/chezdav.c:183
msgid "Listen on loopback only"
msgstr "Prisluhni le povratni zanki"

#: bin/chezdav.c:184
msgid "Listen on all interfaces"
msgstr "Prisluhni vsem vmesnikom"

#: bin/chezdav.c:185
msgid "Path to export"
msgstr "Pot za izvoz"

#: bin/chezdav.c:186
msgid "Path to htdigest file"
msgstr "Pot do datoteke htdigest"

#: bin/chezdav.c:187
msgid "DIGEST realm"
msgstr "Področje DIGEST"

#: bin/chezdav.c:188
msgid "Read-only access"
msgstr "Le za branje"

#: bin/chezdav.c:189
msgid "Refuse uploads over SIZE bytes (0 for no limit)"
msgstr ""
"Zavrni nalaganje datotek, večjih od VELIKOST bajtov (0 pomeni brez omejitve)"

#: bin/chezdav.c:189
msgid "SIZE"
msgstr "VELIKOST"

#: bin/chezdav.c:190
msgid ""
"Serve HTTPS, with the TLS certificate in CERT (which must include the "
"private key, unless --tls-key is given)"
msgstr ""
"Zagotovi HTTPS s TLS-potrdilom v mapi POTR (ki mora vsebovati zasebni "
"ključ, razen če je naveden parameter --tls-key)"

#: bin/chezdav.c:190
msgid "CERT"
msgstr "POTR"

#: bin/chezdav.c:191
msgid "Path to the TLS private key, when it is not in the certificate file"
msgstr "Pot do zasebnega ključa TLS, če ta ni v datoteki s potrdilom"

#: bin/chezdav.c:191
msgid "KEY"
msgstr "KLJUČ"

#: bin/chezdav.c:193
msgid "Skip mDNS service announcement"
msgstr "Preskoči objavo storitve MDNS"

#: bin/chezdav.c:205
msgid "- simple WebDAV server"
msgstr "– enostaven strežnik WebDAV"

#: bin/chezdav.c:206
#, c-format
msgid "Report bugs to <%s>"
msgstr "Poročila o hroščih pošljite na <%s>"

#: bin/chezdav.c:212
#, c-format
msgid "Option parsing failed: %s\n"
msgstr "Razčlenjevanje možnosti je spodletelo: %s\n"

#: bin/chezdav.c:219
#, c-format
msgid "Unsupported extra arguments: %s ...\n"
msgstr "Nepričakovani dodatni argumenti: %s ...\n"

#: bin/chezdav.c:228
#| msgid "--local and --public are mutually exclusive\n"
msgid "--socket and --local are mutually exclusive\n"
msgstr "--socket in --local se medsebojno izključujeta\n"

#: bin/chezdav.c:230
#| msgid "--local and --public are mutually exclusive\n"
msgid "--socket and --public are mutually exclusive\n"
msgstr "--socket in --public se medsebojno izključujeta\n"

#: bin/chezdav.c:232
#| msgid "--local and --public are mutually exclusive\n"
msgid "--socket and --port are mutually exclusive\n"
msgstr "--socket in --port se medsebojno izključujeta\n"

#: bin/chezdav.c:234
msgid "--local and --public are mutually exclusive\n"
msgstr "--local in --public sta nezdružljiva parametra\n"

#: bin/chezdav.c:237
msgid "--max-upload must not be negative\n"
msgstr "--max-upload mora biti negativno\n"

#: bin/chezdav.c:240
msgid "--tls-key requires --tls-cert\n"
msgstr "--tls-key zahteva --tls-cert\n"

#: bin/chezdav.c:280
#, c-format
msgid "Failed to load the certificate: %s\n"
msgstr "Nalaganje potrdila je spodletelo: %s\n"

#: bin/chezdav.c:308
#, c-format
msgid "Failed to open htdigest: %s\n"
msgstr "Odpiranje htdigest je spodletelo: %s\n"

#: bin/chezdav.c:322
#, c-format
msgid "mDNS failed: %s\n"
msgstr "Izvajanje mDNS je spodletelo %s\n"

#: bin/chezdav.c:345
#, c-format
msgid "Listen failed: %s\n"
msgstr "Prisluh je spodletel: %s\n"
