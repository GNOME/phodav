#: bin/chezdav.c:120
msgid "Print program version"
msgstr "Prytyna versyon towlen"

#: bin/chezdav.c:121
msgid "Be verbose"
msgstr "Bos gerennek"

#: bin/chezdav.c:122
msgid "Port to listen to"
msgstr "Porth rag goslowes orth"

#: bin/chezdav.c:123
msgid "Listen on loopback only"
msgstr "Goslowes orth war kabester hepken"

#: bin/chezdav.c:124
msgid "Listen on all interfaces"
msgstr "Goslowes orth war oll ynterfassow"

#: bin/chezdav.c:125
msgid "Path to export"
msgstr "Tyller rag esporth"

#: bin/chezdav.c:126
msgid "Path to htdigest file"
msgstr "Tyller rag restren htdigest"

#: bin/chezdav.c:127
msgid "DIGEST realm"
msgstr "Gwlaskor DIGEST"

#: bin/chezdav.c:128
msgid "Read-only access"
msgstr "Hedhas redya-hepken"

#: bin/chezdav.c:130
msgid "Skip mDNS service announcement"
msgstr "Skyppya gwarnyans gonis mDNS"

#: bin/chezdav.c:142
msgid "- simple WebDAV server"
msgstr "- servell sempel WebDAV"

#: bin/chezdav.c:143
#, c-format
msgid "Report bugs to <%s>"
msgstr "Derivas kudynnow dhe <%s>"

#: bin/chezdav.c:150
#, c-format
msgid "Option parsing failed: %s\n"
msgstr "Ow redya dewisyow fyllis: %s\n"

#: bin/chezdav.c:154
#, c-format
msgid "Unsupported extra arguments: %s ...\n"
msgstr "Oberadowyow anskoodhys moy: %s ...\n"

#: bin/chezdav.c:163
msgid "--local and --public are mutually exclusive\n"
msgstr "--local ha --poblek yw kesekskludus\n"

#: bin/chezdav.c:189
#, c-format
msgid "Failed to open htdigest: %s\n"
msgstr "Y fyllis ygeri htdigest: %s\n"

#: bin/chezdav.c:204
#, c-format
msgid "mDNS failed: %s\n"
msgstr "mDNS fyllis: %s\n"

#: bin/chezdav.c:215
msgid "Internal error, should not happen\n"
msgstr "Error pervedhek, ny kodh happya\n"

#: bin/chezdav.c:218
#, c-format
msgid "Listen failed: %s\n"
msgstr "Goslowes orth fyllis: %s\n"
