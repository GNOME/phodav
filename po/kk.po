#: bin/chezdav.c:120
msgid "Print program version"
msgstr "Бағдарлама нұсқасын шығару"

#: bin/chezdav.c:121
msgid "Be verbose"
msgstr "Толық ақпаратты шығару"

#: bin/chezdav.c:122
msgid "Port to listen to"
msgstr "Тыңдайтын порт"

#: bin/chezdav.c:123
msgid "Listen on loopback only"
msgstr "Тек loopback арқылы тыңдау"

#: bin/chezdav.c:124
msgid "Listen on all interfaces"
msgstr "Барлық интерфейстерде тыңдау"

#: bin/chezdav.c:125
msgid "Path to export"
msgstr "Экспортталатын жол"

#: bin/chezdav.c:126
msgid "Path to htdigest file"
msgstr "htdigest файлына баратын жол"

#: bin/chezdav.c:127
msgid "DIGEST realm"
msgstr "DIGEST аймағы"

#: bin/chezdav.c:128
msgid "Read-only access"
msgstr "Тек оқу үшін қол жеткізу"

#: bin/chezdav.c:130
msgid "Skip mDNS service announcement"
msgstr "mDNS қызметін жариялауды өткізіп жіберу"

#: bin/chezdav.c:142
msgid "- simple WebDAV server"
msgstr "- қарапайым WebDAV сервері"

#: bin/chezdav.c:143
#, c-format
msgid "Report bugs to <%s>"
msgstr "Қателер туралы <%s> адресіне хабарлаңыз"

#: bin/chezdav.c:150
#, c-format
msgid "Option parsing failed: %s\n"
msgstr "Опцияларды талдау сәтсіз аяқталды: %s\n"

#: bin/chezdav.c:154
#, c-format
msgid "Unsupported extra arguments: %s ...\n"
msgstr "Қолдау көрсетілмейтін қосымша аргументтер: %s ...\n"

#: bin/chezdav.c:163
msgid "--local and --public are mutually exclusive\n"
msgstr "--local және --public бірін-бірі жоққа шығарады\n"

#: bin/chezdav.c:189
#, c-format
msgid "Failed to open htdigest: %s\n"
msgstr "htdigest файлын ашу сәтсіз аяқталды: %s\n"

#: bin/chezdav.c:204
#, c-format
msgid "mDNS failed: %s\n"
msgstr "mDNS сәтсіз аяқталды: %s\n"

#: bin/chezdav.c:215
msgid "Internal error, should not happen\n"
msgstr "Ішкі қате, орын алмауы тиіс\n"

#: bin/chezdav.c:218
#, c-format
msgid "Listen failed: %s\n"
msgstr "Тыңдау сәтсіз аяқталды: %s\n"
