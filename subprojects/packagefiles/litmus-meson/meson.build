# Meson build for the litmus WebDAV compliance test suite, used as an
# optional subproject of phodav.  It builds all the test programs of
# litmus' own build (ALL_TESTS) and the litmus(1) driver script running
# the default test suites (basic, http, props, locks, copymove).
#
# The build requires the neon HTTP/WebDAV client library to be installed
# on the system; everything else is built from the litmus source tree.

project('litmus', 'c',
  version : '0.18',
  license : 'GPL-2.0-or-later',
  meson_version : '>= 1.0.0',
  default_options : ['c_std=gnu11', 'warning_level=1'],
)

cc = meson.get_compiler('c')

neon = dependency('neon', version : '>= 0.29')

# same build configuration as litmus' own configure script: litmus
# hooks into neon's test framework via litmus_init()
add_project_arguments('-D_GNU_SOURCE',
                      '-DNEON_TEST_INIT=litmus_init',
                      language : 'c')

# equivalent of the config.h generated by litmus' configure script
conf = configuration_data()

# the neon library version, normally AC_DEFINEd into config.h by
# neon's neon.m4 macros (from neon-config --version)
neon_version = neon.version().split('.')
conf.set('NE_VERSION_MAJOR', '(' + neon_version[0] + ')')
conf.set('NE_VERSION_MINOR', '(' + neon_version[1] + ')')
conf.set('NE_VERSION_PATCH', '(' + neon_version[2].split('-')[0] + ')')

# printf format strings for integer types, normally defined by neon's
# NEON_FORMAT m4 macros; the C99 specifiers are correct with c_std=gnu11
conf.set_quoted('NE_FMT_SIZE_T', 'zu')
conf.set_quoted('NE_FMT_LONG_LONG', 'lld')
conf.set_quoted('PACKAGE_VERSION', meson.project_version())
# litmus runs no test child processes
conf.set('NEON_NO_TEST_CHILD', 1)
foreach h : ['errno', 'locale', 'signal', 'stdint', 'stdlib', 'string', 'unistd']
  if cc.has_header(h + '.h')
    conf.set('HAVE_' + h.to_upper() + '_H', 1)
  endif
endforeach
if cc.has_function('isatty', prefix : '#include <unistd.h>')
  conf.set('HAVE_ISATTY', 1)
endif
if cc.has_function('setlocale', prefix : '#include <locale.h>')
  conf.set('HAVE_SETLOCALE', 1)
endif
config_h = configure_file(input : 'config.h.in', output : 'config.h',
                          configuration : conf)

# the vendored neon test framework lives in neon-test-common/ (the
# equivalent of upstream's -I test-common include)
inc = include_directories('.', 'neon-test-common')

# the code shared by all test suites: litmus' own helpers plus the
# vendored copy of neon's test framework (see neon-test-common/)
libtest = static_library('litmus-test',
  [config_h, 'src/common.c', 'neon-test-common/tests.c'],
  include_directories : inc,
  dependencies : neon)

# the default test suites, run by the litmus(1) driver script
suites = ['basic', 'http', 'props', 'locks', 'copymove']

# additional test programs, built but not run by default; select them
# with the TESTS environment variable of the litmus(1) script
extra_suites = ['largefile', 'protected']

foreach suite : suites + extra_suites
  executable(suite, [config_h, f'src/@suite@.c'],
             include_directories : inc,
             link_with : libtest,
             dependencies : neon,
             install : false)
endforeach

# the lockbomb locking stress test, in single- and multi-threaded
# variants (upstream builds the latter only when pthreads are found)
executable('lockbomb-single', [config_h, 'src/lockbomb.c'],
           c_args : '-DTHREADS=1',
           include_directories : inc,
           link_with : libtest,
           dependencies : neon,
           install : false)

threads = dependency('threads', required : false)
if threads.found()
  executable('lockbomb', [config_h, 'src/lockbomb.c'],
             c_args : '-DHAVE_PTHREADS',
             include_directories : inc,
             link_with : libtest,
             dependencies : [neon, threads],
             install : false)
endif

# drop-in replacement for the litmus(1) driver script
script_conf = configuration_data()
script_conf.set('VERSION', meson.project_version())
script_conf.set('TESTS', ' '.join(suites))
script_conf.set('TESTROOT', meson.current_build_dir())
litmus_sh = configure_file(input : 'litmus.sh.in', output : 'litmus',
                           configuration : script_conf)

litmus_prog = find_program(litmus_sh)
meson.override_find_program('litmus', litmus_prog)
