/* Configuration for litmus, generated by meson.  This is the
 * equivalent of the config.h generated by litmus' configure script
 * when building against a system neon library (see README-meson.md). */

/* litmus version string */
#mesondefine PACKAGE_VERSION

/* neon library version, as reported by pkg-config; the
 * NE_MINIMUM_VERSION macro below comes from neon's neon.m4 */
#mesondefine NE_VERSION_MAJOR
#mesondefine NE_VERSION_MINOR
#mesondefine NE_VERSION_PATCH
#define NE_MINIMUM_VERSION(majv_, minv_) \
    (((majv_) == NE_VERSION_MAJOR && NE_VERSION_MINOR >= (minv_)) \
     || NE_VERSION_MAJOR > (majv_))

/* printf format strings for integer types, normally defined by
 * neon's NEON_FORMAT m4 macros */
#mesondefine NE_FMT_SIZE_T
#mesondefine NE_FMT_LONG_LONG

/* litmus runs no test child processes */
#mesondefine NEON_NO_TEST_CHILD

#mesondefine HAVE_ERRNO_H
#mesondefine HAVE_LOCALE_H
#mesondefine HAVE_SIGNAL_H
#mesondefine HAVE_STDINT_H
#mesondefine HAVE_STDLIB_H
#mesondefine HAVE_STRING_H
#mesondefine HAVE_UNISTD_H
#mesondefine HAVE_ISATTY
#mesondefine HAVE_SETLOCALE
